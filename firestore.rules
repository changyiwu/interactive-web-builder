rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用判斷 ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // SHA-256 十六進位字串（64 位小寫）
    function isSha256Hex(value) {
      return value is string
        && value.size() == 64
        && value.matches('^[0-9a-f]{64}$');
    }

    // 管理者授權：比對使用者臨時憑證與 config/admin 的密碼雜湊。
    // 前端只會送出 SHA-256 雜湊，明文密碼不離開瀏覽器；config 前端完全不可讀寫，
    // 只有安全規則內部的 get() 能取用（get() 不受 read 規則限制）。
    function isAdmin() {
      return exists(/databases/$(database)/documents/admin_auth/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_auth/$(request.auth.uid)).data.passwordHash
           == get(/databases/$(database)/documents/config/admin).data.passwordHash;
    }

    // ---------- 集合規則 ----------

    // 設定文件：僅供安全規則內部比對，前端完全不可讀寫
    match /config/{document} {
      allow read, write: if false;
    }

    // 管理者臨時憑證：只能操作自己的文件，且只能放 SHA-256 雜湊
    match /admin_auth/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['passwordHash'])
        && isSha256Hex(request.resource.data.passwordHash);

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /words/{word} {
      allow read: if isSignedIn();

      // 只能寫自己的字詞，且欄位、長度、次數都必須在合理範圍內。
      // hasOnly 擋掉夾帶額外欄位灌爆文件（單份上限 1MB）的手法。
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['text', 'count', 'timestamp', 'uid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100
        && request.resource.data.count is int
        && request.resource.data.count > 0
        && request.resource.data.count <= 1000
        && request.resource.data.timestamp == request.time
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid + '_' + request.resource.data.text == word;

      // 一般使用者只能刪自己的；一鍵刪除全部需通過 isAdmin() 的雜湊比對
      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- word-cloud-page 技能產生的文字雲頁 ----------
    // 每產生一份文字雲頁就給它一個 cloudId，資料各自落在自己的子集合，互不干擾。
    // 欄位規格與上方 /words/ 完全一致（同一份程式碼改路徑而已）；共用 config/admin，
    // 所以一組管理密碼可以清空任何一份文字雲。
    //
    // ⚠️ 用子集合而不是每份新開一個 <cloudId>_words 集合：安全規則的路徑片段只能是
    // 完整字面值或完整萬用字元，寫不出 match /{cloudId}_words/；且那樣每產生一份
    // 文字雲都得改規則再部署一次。子集合一條規則涵蓋全部，新增文字雲不必碰規則。
    match /clouds/{cloudId}/words/{word} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && cloudId.matches('^[a-zA-Z0-9_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['text', 'count', 'timestamp', 'uid'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 100
        && request.resource.data.count is int
        && request.resource.data.count > 0
        && request.resource.data.count <= 1000
        && request.resource.data.timestamp == request.time
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid + '_' + request.resource.data.text == word;

      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- poll-page 技能產生的投票頁 ----------
    // 一人一題一份文件（ID = <uid>_<題號>）：改投票是覆寫自己那份，天然防灌票，
    // 也不會有多人搶寫同一份文件的熱點。delete 允許 isAdmin()，讓講者能一鍵重置票數。
    match /polls/{pollId}/votes/{ballot} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn()
        && pollId.matches('^[a-zA-Z0-9_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['question', 'option', 'uid', 'updated_at'])
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 40
        && request.resource.data.option is string
        && request.resource.data.option.size() > 0
        && request.resource.data.option.size() <= 40
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updated_at == request.time
        && request.resource.data.uid + '_' + request.resource.data.question == ballot;

      // 一般聽眾只能收回自己那票；「一鍵重置投票」需通過 isAdmin() 的雜湊比對
      allow delete: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // 2026-08-05：移除 /decks/{slug}/wordcloud 與 /decks/{slug}/votes 兩條規則。
    // 那是 html-slide-builder 簡報內嵌互動元件用的路徑，該功能已整組移除，
    // 改用上方 /clouds/ 與 /polls/ 的獨立互動頁；已確認沒有任何簡報還在用。
  }
}
